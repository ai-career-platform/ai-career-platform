# GOAL_2 one-shot GCP sync from this PC (run-gcp-sync-local.ps1). TEMPLATE ONLY - no real values.
# Copy to C:\dev\crawler-data\secrets\gcp-sync.env (ACL: this user + SYSTEM only), never into Git.
# Use the dedicated least-privilege career_sync role (poc/staging/automation/gcp-sync/target_grants.sql).
# Admin roles (postgres, cloudsqlsuperuser, cloudsqladmin) are refused by crawler/jobs/gcp_sync.py.
# The repository root .env *_GCP keys are NOT used by the sync.
# Also place the Cloud SQL instance CA as C:\dev\crawler-data\secrets\gcp-server-ca.pem.
GCP_SYNC_TARGET_HOST=
GCP_SYNC_TARGET_HOSTADDR=
GCP_SYNC_TARGET_PORT=5432
GCP_SYNC_TARGET_DB=ai_career_poc
GCP_SYNC_TARGET_USER=career_sync
GCP_SYNC_TARGET_PASSWORD=
GCP_SYNC_PUBLISH=0
