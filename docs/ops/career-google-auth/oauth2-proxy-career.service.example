# DESIGN DRAFT (#265) - not a deploy file. Target: /etc/systemd/system/oauth2-proxy-career.service (#266)
[Unit]
Description=oauth2-proxy (Google allowlist gate for AI Career Platform /career/ only)
After=network-online.target
Wants=network-online.target

[Service]
User=oauth2-proxy
Group=oauth2-proxy
ExecStart=/usr/local/bin/oauth2-proxy --config=/etc/oauth2-proxy/career/oauth2-proxy.cfg
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/oauth2-proxy/career
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
