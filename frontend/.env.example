# 복사해서 .env.local 로 사용 (Git 제외). 비밀정보를 넣지 않습니다 — VITE_* 값은 브라우저 번들에 그대로 노출됩니다.

# 브라우저가 호출할 API 기본 경로. 같은 Origin의 Nginx 프록시(/api)를 기본으로 사용.
VITE_API_BASE_URL=/api

# true면 실제 Backend 대신 src/mocks 의 가상 데이터를 사용
VITE_API_MOCK=false

# npm run dev 시 /api 요청을 전달할 대상 (로컬 PoC Nginx: poc/staging docker compose)
DEV_API_PROXY_TARGET=http://127.0.0.1:18080
