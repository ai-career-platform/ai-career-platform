STAGING_SSH_HOST=
STAGING_SSH_PORT=
STAGING_SSH_USER=
STAGING_SSH_KEY_PATH=
STAGING_SSH_ALIAS=

# T14 backend (export these values before starting uvicorn)
DATABASE_URL=
DB_POOL_SIZE=5
DB_TIMEOUT_SECONDS=5

# T15 auth (JWT_SECRET: 32자 이상 임의 문자열. 실제 값은 저장소에 커밋하지 말 것)
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
AUTH_COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=30
SIGNUP_IP_MAX_ATTEMPTS=10
AUTH_RATE_WINDOW_SECONDS=900

# T49: absolute path to a dedicated directory (0700); unset disables file I/O.
# Set to a private noexec volume in deployment, outside the repository/web root.
DOCUMENT_STORAGE_ROOT=

# T111 environment contract (backend/app/core/env_contract.py, docs/ops/ENVIRONMENT_MATRIX.md)
# Staging requires APP_ENV=staging, APP_VERSION, DATABASE_URL and JWT_SECRET. Never commit real values.
APP_ENV=local-dev
APP_VERSION=0.1.0
PASSWORD_RESET_LINK_BASE=/password-reset

# Unapproved features stay off until the PM approves them (true/false only)
BEHAVIOR_EVENTS_ENABLED=false
BEHAVIOR_EVENTS_RATE_LIMIT=
JOB_SEARCH_ADVANCED=false
JOB_APPLICATIONS_API=false
CRAWLER_ADMIN_WRITE_API=false
COMPANY_ACCOUNTS_API=false
COMPANY_POSTINGS_API=false
SKILL_AUTOCOMPLETE_API=false
PUBLIC_PORTFOLIO_API=false
PERSONAL_DATA_REQUESTS_API=false
