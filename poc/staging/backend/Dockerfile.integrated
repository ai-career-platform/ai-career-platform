FROM python:3.12.10-slim
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY poc/staging/backend/main.py .
COPY crawler ./crawler
COPY backend/app ./backend/app
COPY backend/training_jobs_api.py ./backend/training_jobs_api.py
COPY backend/training_frontend ./backend/training_frontend
ENV ENABLE_CRAWLER_API=1 ENABLE_SERVICE_API=1 PYTHONPATH=/app/backend
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
