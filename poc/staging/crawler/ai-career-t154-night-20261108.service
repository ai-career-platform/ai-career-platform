[Unit]
Description=T154 synthetic fixture one-shot for 2026-11-08 night only
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=kant
Group=kant
WorkingDirectory=/home/kant/ai-career-staging-poc
ExecStart=/usr/bin/flock --nonblock /home/kant/ai-career-staging-poc/.t154-night.lock /usr/bin/bash /home/kant/ai-career-staging-poc/bin/t154-night-once-20261108.sh
TimeoutStartSec=180
TimeoutStopSec=25
KillMode=control-group
NoNewPrivileges=true
Restart=no
